{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-skill-hub.local/schemas/project_runtime_pack_schema_v1.json",
  "title": "ai-skill-hub Project Runtime Pack Manifest V1",
  "description": "Frozen schema v1 for .ai/runtime-pack.json generated by tools/init_project_runtime_pack.ps1. Key order and adapter ordering are fixed by the design contract but are not expressible in JSON Schema; the initializer's built-in validator enforces them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator",
    "hub",
    "routing",
    "adapters"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "ai-skill-hub.project-runtime-pack"
        },
        "version": {
          "const": 1
        }
      }
    },
    "hub": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "path",
        "url",
        "requested_ref",
        "resolved_commit"
      ],
      "properties": {
        "mode": {
          "enum": [
            "submodule",
            "external-path"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string"
        },
        "requested_ref": {
          "type": "string",
          "minLength": 1
        },
        "resolved_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "canonical_index"
      ],
      "properties": {
        "strategy": {
          "const": "thin-router"
        },
        "canonical_index": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "adapters": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "management",
          "content_sha256"
        ],
        "properties": {
          "id": {
            "enum": [
              "agents-entry",
              "claude-entry",
              "claude-router",
              "copilot-entry",
              "shared-router"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "(^/)|(\\\\)|(^|/)\\.\\.?(/|$)"
            }
          },
          "management": {
            "enum": [
              "managed-block",
              "generated-file"
            ]
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
